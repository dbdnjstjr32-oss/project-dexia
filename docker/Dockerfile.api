# dexia-api — FastAPI control plane + OAG/Logic pipeline + evals/health endpoints.
# Lightweight: no Ray/MuJoCo (it's a stateless control plane over the event bus).
FROM python:3.13-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

COPY requirements-runtime.txt .
RUN pip install --no-cache-dir -r requirements-runtime.txt

COPY dexia/ ./dexia/
COPY dexia.config.yaml ./

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=4s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/sim/health',timeout=3).status==200 else 1)"

CMD ["uvicorn", "dexia.api.sim_api:app", "--host", "0.0.0.0", "--port", "8000"]
