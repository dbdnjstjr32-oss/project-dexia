# dexia-sim — the physics + MARL simulator streamer (the stack's heartbeat).
# Heavy image: Ray RLlib + MuJoCo + Torch behind the PhysicsEngine ABC. Pinned to
# Python 3.12 (the trained-checkpoint interpreter); the API/evals run on 3.13.
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# MuJoCo needs a couple of GL/maths shared libs even in headless mode.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-runtime.txt ./
# Core sim deps + the event-bus client.
RUN pip install --no-cache-dir -r requirements.txt redis>=5.0 PyYAML>=6.0
# Full MARL backend: DroneMARLEnv subclasses ray.rllib MultiAgentEnv and the
# physics module imports MuJoCo at top level, so the streamer needs all three.
# CPU-only Torch keeps the image off the multi-GB CUDA wheels.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir "ray[rllib]>=2.9" "mujoco>=3.0"

COPY dexia/ ./dexia/
COPY telemetry_stream.py dexia.config.yaml ./

# The streamer is the heartbeat HealthMonitor watches; restart policy bounces it.
CMD ["python", "telemetry_stream.py", "--hz", "10"]
